{
  "name": "aphelion",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "postinstall": "node setup.mjs",
    "setup": "node setup.mjs",
    "dev": "node setup.mjs && next dev",
    "build": "node setup.mjs && next build",
    "start": "next start",
    "typecheck": "node setup.mjs && tsc --noEmit",
    "test": "node setup.mjs && tsx tests/t.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/three": "0.169.0",
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  },
  "description": "Aphelion: a space-science research search engine (arXiv, OpenAlex, Crossref, NASA ADS, SIMBAD).",
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  }
}
